   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "snr = np.arange(0, 11)\n",
    "ber = 0.5 * np.exp(-snr / 3)\n",
    "\n",
    "plt.plot(snr, ber, 'o-', label='BER')\n",
    "plt.xlabel('SNR (dB)')\n",
    "plt.ylabel('BER')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.savefig('ber.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  }
 ],
